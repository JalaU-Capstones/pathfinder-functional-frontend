# Backend API base URL
# In development, Vite proxies /api requests to this URL.
# Change only if your backend runs on a different port.
VITE_API_BASE_URL=http://localhost:3000
# localStorage key used to store the JWT token.
# Change this if multiple apps share the same origin
# to prevent key collisions in localStorage.
VITE_TOKEN_KEY=pathfinder_auth_token
